{
  "openapi": "3.1.0",
  "info": {
    "title": "Morning Brief Connector API",
    "description": "Microsoft 365 integration for emails and calendar events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://morning-brief-connector.reinier-olivier.workers.dev"
    }
  ],
  "paths": {
    "/brief": {
      "get": {
        "operationId": "getMorningBrief",
        "summary": "Get Morning Intelligence Brief",
        "description": "Retrieves new emails, important emails, today's calendar events, and upcoming events",
        "responses": {
          "200": {
            "description": "Successful response with email and calendar data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "emailData": {
                      "type": "object",
                      "properties": {
                        "new_messages": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "subject": { "type": "string" },
                              "sender_email": { "type": "string" },
                              "sender_name": { "type": "string" },
                              "received_at": { "type": "string" },
                              "importance": { "type": "string" },
                              "body_preview": { "type": "string" }
                            }
                          }
                        },
                        "important_messages": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "subject": { "type": "string" },
                              "sender_email": { "type": "string" },
                              "sender_name": { "type": "string" },
                              "received_at": { "type": "string" },
                              "importance": { "type": "string" },
                              "body_preview": { "type": "string" }
                            }
                          }
                        }
                      }
                    },
                    "calendarData": {
                      "type": "object",
                      "properties": {
                        "today_events": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "subject": { "type": "string" },
                              "start_at": { "type": "string" },
                              "end_at": { "type": "string" },
                              "location": { "type": "string" },
                              "organiser": { "type": "string" }
                            }
                          }
                        },
                        "upcoming_events": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "subject": { "type": "string" },
                              "start_at": { "type": "string" },
                              "end_at": { "type": "string" },
                              "location": { "type": "string" },
                              "organiser": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/calendar/events": {
      "post": {
        "operationId": "createCalendarEvent",
        "summary": "Create a calendar event",
        "description": "Creates a new event in the user's Microsoft 365 calendar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subject", "startTime", "endTime", "timezone"],
                "properties": {
                  "subject": { 
                    "type": "string",
                    "description": "Event title/subject"
                  },
                  "startTime": { 
                    "type": "string",
                    "description": "ISO 8601 datetime (e.g., 2024-01-15T09:00:00)"
                  },
                  "endTime": { 
                    "type": "string",
                    "description": "ISO 8601 datetime (e.g., 2024-01-15T10:00:00)"
                  },
                  "timezone": { 
                    "type": "string",
                    "description": "IANA timezone (e.g., America/New_York)"
                  },
                  "location": { "type": "string" },
                  "body": { "type": "string" },
                  "attendees": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created successfully"
          }
        }
      }
    },
    "/drafts/compose": {
      "post": {
        "operationId": "createEmailDraft",
        "summary": "Create an email draft",
        "description": "Creates a new email draft in the user's Microsoft 365 mailbox",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to", "subject", "body"],
                "properties": {
                  "to": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Recipient email addresses"
                  },
                  "subject": { "type": "string" },
                  "body": { "type": "string" },
                  "cc": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "importance": {
                    "type": "string",
                    "enum": ["low", "normal", "high"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created successfully"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
