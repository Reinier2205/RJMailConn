# Production Configuration Template
# Copy to wrangler.jsonc and fill in your values

{
  "name": "microsoft-365-mail-connector",
  "main": "dist/index.js",
  "compatibility_date": "2024-01-01",
  "node_compat": true,
  
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mail-connector-db",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  
  "triggers": {
    "crons": ["15 * * * *"]
  },
  
  "vars": {
    "REDIRECT_URI": "https://<YOUR-WORKER>.workers.dev/auth/callback"
  }
}

# Required Secrets (set with: wrangler secret put <NAME>)
# - CLIENT_ID: Microsoft Entra ID Application (client) ID
# - CLIENT_SECRET: Microsoft Entra ID Client secret value
# - TENANT_ID: Microsoft Entra ID Directory (tenant) ID
# - CONNECTOR_API_TOKEN: Generated secure token for API authentication
